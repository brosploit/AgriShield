# AgriShield AI Backend Environment Configuration Example
PROJECT_NAME="AgriShield AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# Default PostgreSQL cluster on port 5433 (or standard 5432)
# Also supports sqlite:///./agrishield_dev.db for lightweight testing
DATABASE_URL="postgresql+psycopg2://postgres@127.0.0.1:5433/agrishield"
TEST_DATABASE_URL="sqlite:///./test_agrishield.db"

# Security & Authentication
# Generate in production using: openssl rand -hex 32
SECRET_KEY="agrishield-super-secret-key-change-in-production-random-hex-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# AI/ML Model Settings
MODEL_VERSION="1.0.0-baseline"
ML_MODEL_PATH="ml/models"

# Storage & Verification
STORAGE_HASH_SALT="agrishield-grain-verification-salt-2026"

