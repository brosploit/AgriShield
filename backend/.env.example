# AgriShield AI Backend Environment Configuration Template
PROJECT_NAME="AgriShield AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/agrishield"
TEST_DATABASE_URL="sqlite:///./test_agrishield.db"

# Security & Authentication
SECRET_KEY="generate-a-strong-random-secret-key-for-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (JSON List of Allowed Origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8080","http://127.0.0.1:8080"]

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# AI/ML Model Settings
MODEL_VERSION="1.0.0-baseline"
ML_MODEL_PATH="ml/models"

# Storage & Verification
STORAGE_HASH_SALT="agrishield-grain-verification-salt-2026"

